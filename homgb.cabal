cabal-version: 2.4
name:          homgb
version:       0.1.0.0
synopsis:      X11 notification daemon, system tray host, and keyboard layout manager
description:   Desktop notification center with StatusNotifierItem tray and
               keyboard layout management. SDL2 windowing, dear-imgui rendering.
               X11 only (initially).
build-type:    Simple
license:       BSD-3-Clause

library
  hs-source-dirs:      src
  exposed-modules:     Homgb
                     , Homgb.State
                     , Homgb.Render
                     , Homgb.Config
                     , Homgb.Helpers
                     , Homgb.GL.Texture
                     , Homgb.Notifications.Data
                     , Homgb.Notifications.Daemon
                     , Homgb.Tray
                     , Homgb.Tray.Icons
                     , Homgb.Tray.Render
                     , Homgb.Tray.Menu.Client
                     , Homgb.Tray.Menu.Tree
                     , Homgb.Tray.Menu.Render
  build-depends:       base >= 4.7 && < 5
                     , bytestring
                     , sdl2 >= 2.5
                     , dear-imgui >= 2.5
                     , gl
                     , managed
                     , linear
                     , stm
                     , containers
                     , text
                     , mtl
                     , directory
                     , filepath
                     , process
                     , unix
                     , time
                     , dbus >= 1.2 && < 2
                     , X11
                     , status-notifier-item >= 0.3.2.16 && < 0.4
                     , yaml
                     , aeson
                     , JuicyPixels >= 3.3 && < 3.4
                     , vector
                     , tagsoup
                     , split
                     , haskell-gettext
                     , lens
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wredundant-constraints

executable homgb
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       base
                     , homgb
  default-language:    Haskell2010
  ghc-options:         -Wall -O2
