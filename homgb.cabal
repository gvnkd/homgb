cabal-version: 2.4
name:          homgb
version:       0.1.0.0
synopsis:      X11 notification daemon, system tray host, and keyboard layout manager
description:   Desktop notification center with StatusNotifierItem tray and
               keyboard layout management. SDL2 windowing, dear-imgui rendering.
               X11 only (initially).
build-type:    Simple
license:       BSD-3-Clause

library
  hs-source-dirs:      src
  exposed-modules:     Homgb
                     , Homgb.State
                     , Homgb.Render
                      , Homgb.Config
                      , Homgb.Theme
                      , Homgb.Monitors
                      , Homgb.Bar
                      , Homgb.Helpers
                      , Homgb.GL.Texture
                      , Homgb.WMProps
                      , Homgb.SDL3
                      , Homgb.ImGui.SDL3
                      , Homgb.Surface
                     , Homgb.Notifications.Data
                     , Homgb.Notifications.Daemon
                     , Homgb.Tray
                     , Homgb.Tray.Icons
                     , Homgb.Tray.Render
                      , Homgb.Tray.Menu.Client
                      , Homgb.Tray.Menu.Tree
                      , Homgb.Tray.Menu.Render
                      , Homgb.Keyboard
                      , Homgb.Keyboard.Xcb
                      , Homgb.Control
  build-depends:       base >= 4.7 && < 5
                      , bytestring
                      , sdl3-bindgen-sys >= 0.0.0.3 && < 0.0.1
                      , dear-imgui >= 2.5
                      , gl
                      , managed
                      , linear
                     , stm
                     , containers
                     , text
                     , mtl
                     , directory
                     , filepath
                     , process
                     , unix
                     , time
                     , dbus >= 1.2 && < 2
                     , X11
                     , status-notifier-item >= 0.3.2.16 && < 0.4
                     , yaml
                     , aeson
                     , JuicyPixels >= 3.3 && < 3.4
                     , vector
                     , tagsoup
                     , split
                     , haskell-gettext
                     , lens
  c-sources:           cbits/homgb-xkb.c
  cxx-sources:         cbits/homgb-imgui-sdl3.cpp
                      , vendor/imgui/backends/imgui_impl_sdl3.cpp
  cxx-options:         -std=c++11 -DIMGUI_USE_WCHAR32 "-DImDrawIdx=unsigned int"
  include-dirs:        vendor/imgui, vendor/imgui/backends
  pkgconfig-depends:   xcb, xcb-xkb, x11, sdl3
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wredundant-constraints

executable homgb
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       base
                      , homgb
  default-language:    Haskell2010
  -- -threaded: the design relies on blocking C calls in DBus/X11/XCB
  -- threads coexisting with the SDL render loop (see architecture notes
  -- in .opencode/MEMORIES.md); without this they freeze the whole RTS.
  ghc-options:         -Wall -O2 -threaded
